<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AudioPlayerService asks whether a connection exists before it retries a failed track. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ExoPlayer setWakeMode: keep the CPU awake while music plays with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>

        <!--
          The built-in player: one media library session for the notification, the lock screen,
          Bluetooth, Wear and Android Auto, which also browses the app's playlists through it.
          Exported for the system and the car. Who may connect, and with which commands, is
          ControllerAccess: the app, the system and Google's car, assistant and Wear apps (checked
          by signing certificate) fully, media-control apps only for play/pause/skip/seek, any
          other app not at all. The app's own commands do not use start-service intents but
          PlayerCommands inside the process, so another app's intent cannot stop or seek the
          player. The app's manifest adds the Android Auto entries (browser and voice search) next
          to its automotive declaration.
        -->
        <service
            android:name=".service.AudioPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>
    </application>

</manifest>
