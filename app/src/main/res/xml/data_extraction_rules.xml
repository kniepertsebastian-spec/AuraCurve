<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. Presets, playlists and settings go to a new phone, by cloud backup and by
  cable/wireless transfer, so nothing has to be set up again after a restore.

  The cloud backup is skipped on a phone that cannot encrypt it with the lock screen (no lock
  screen set). A future sign-in token must be excluded here or stored so that it is not part of
  the backup.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true" />
    <device-transfer />
</data-extraction-rules>
